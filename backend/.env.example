# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── LLM providers ─────────────────────────────────────────
# Google Gemini (free tier via AI Studio)

LLM_PROVIDERS=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# # Groq (free tier, rate-limited)
# LLM_PROVIDERS=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── App ────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── First-run admin seeding ────────────────────────────────
# Used once on startup to create the initial Admin account.
# Leave blank to skip seeding.
SEED_ADMIN_EMAIL=Admin123@gmail.com
SEED_ADMIN_PASSWORD=Admin123@
