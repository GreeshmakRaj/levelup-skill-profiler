# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── LLM providers ─────────────────────────────────────────
# Google Gemini (free tier via AI Studio)

LLM_PROVIDERS=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# # Groq (free tier, rate-limited)
# LLM_PROVIDERS=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── App ────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── First-run admin seeding ────────────────────────────────
# Used once on startup to create the initial Admin account.
# Leave blank to skip seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── System-to-system (S2S) API key ─────────────────────────
# Shared secret handed to trusted backends (e.g. other teams) so they can call
# on behalf of an EMPLOYEE-role user without an interactive user session.
# Callers send:
#   X-API-Key: <this value>
#   X-Acting-Employee-Id: <user_id to act as — any EMPLOYEE or MANAGER>
# The key may act as any EMPLOYEE or MANAGER user, but NOT an ADMIN, so
# admin-only endpoints stay forbidden over the API-key path.
# Leave blank to disable the API-key path entirely (JWT-only).
SERVICE_API_KEY=
